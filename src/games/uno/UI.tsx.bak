import React from 'react'
import { useNavigate } from 'react-router-dom'
import { useUnoStore } from '../../store/uno'
import { label, canPlay, cssClass } from './engine'
import Topbar from '../../components/Topbar'
import Card from '../../components/Card'

export default function UnoUI() {
  const navigate = useNavigate()
  const { players, discard, hand, turn, playCard, drawCard, started, results, callUno } = useUnoStore((state) => ({
    players: state.players,
    discard: state.discard,
    hand: state.players[state.turn]?.hand || [],
    turn: state.turn,
    playCard: state.playCard,
    drawCard: state.drawCard,
    started: state.started,
    results: state.results,
    callUno: state.callUno
  }))

  React.useEffect(() => {
    if (!started && results.length > 0) navigate('/uno/results')
  }, [started, results, navigate])

  const topCard = discard[discard.length - 1]

  const right = (
    <span className="rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">
      Tour {turn + 1}/{players.length}
    </span>
  )

  return (
    <div className="min-h-screen bg-bg">
      <Topbar title="UNO" subtitle="Partie en cours" back right={right} />
      <div className="mx-auto flex w-full max-w-xl flex-col gap-6 px-4 pb-24 pt-4">
        <section className="grid gap-3 sm:grid-cols-2">
          {players.map((player, index) => (
            <Card key={player.id} className={`flex items-center justify-between ${index === turn ? 'border-primary/50 shadow-card' : ''}`}>
              <div>
                <p className="text-sm font-semibold text-txt">{player.id}</p>
                <p className="text-xs text-muted">{player.hand.length} cartes restantes</p>
              </div>
              <span
                className={`flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold ${
                  index === turn ? 'bg-primary text-white' : 'bg-primary/10 text-primary'
                }`}
                aria-label="Nombre de cartes"
              >
                {player.hand.length}
              </span>
            </Card>
          ))}
        </section>

        <section className="space-y-3">
          <h2 className="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Plateau</h2>
          <Card className="flex items-center justify-between bg-gradient-to-r from-primary/10 via-surface to-accent/10">
            <div>
              <p className="text-xs uppercase tracking-[0.3em] text-muted">Carte sur le talon</p>
              <p className="mt-2 text-lg font-semibold text-txt">{topCard ? label(topCard) : '—'}</p>
            </div>
            <div className="flex items-center gap-4">
              <div className="flex h-24 w-16 items-center justify-center rounded-2xl border-2 border-dashed border-border/80 bg-bg text-sm text-muted">
                Pioche
              </div>
              <div className={`flex h-24 w-16 items-center justify-center rounded-2xl text-sm font-semibold ${topCard ? cssClass(topCard) : 'bg-panel text-txt'}`}>
                {topCard ? label(topCard) : ''}
              </div>
            </div>
          </Card>
        </section>

        <section className="space-y-3">
          <div className="flex items-center justify-between">
            <h2 className="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Votre main</h2>
            <div className="flex items-center gap-2">
              <button
                onClick={() => callUno()}
                className="rounded-2xl border border-danger/40 bg-danger/10 px-4 py-2 text-xs font-semibold text-danger transition hover:bg-danger/20 focus-ring"
              >
                UNO !
              </button>
              <button
                onClick={() => drawCard()}
                className="rounded-2xl bg-primary px-4 py-2 text-xs font-semibold text-white shadow-card transition hover:bg-primary/90 focus-ring"
              >
                Piocher
              </button>
            </div>
          </div>

          <div className="flex gap-3 overflow-auto pb-2">
            {hand.map((card, index) => {
              const playable = topCard ? canPlay(card, topCard) : false
              return (
                <button
                  key={`${card.color}-${card.value}-${index}`}
                  onClick={() => playable && playCard(index)}
                  disabled={!playable}
                  className={`min-w-[96px] rounded-2xl px-4 py-6 text-base font-semibold text-white shadow-card transition focus-ring disabled:cursor-not-allowed disabled:opacity-40 ${cssClass(card)}`}
                >
                  {label(card)}
                </button>
              )
            })}
          </div>
        </section>
      </div>
    </div>
  )
}

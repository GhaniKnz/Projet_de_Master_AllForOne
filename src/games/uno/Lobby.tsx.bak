import React from 'react'
import { useNavigate } from 'react-router-dom'
import { Plus, Share2 } from 'lucide-react'
import Card from '../../components/Card'
import Topbar from '../../components/Topbar'
import { createGame } from './engine'
import { useUnoStore } from '../../store/uno'

export default function UnoLobby() {
  const navigate = useNavigate()
  const { players, rules, addBot, setRules, startMatch } = useUnoStore((state) => ({
    players: state.players,
    rules: state.rules,
    addBot: state.addBot,
    setRules: state.setRules,
    startMatch: state.startMatch
  }))

  const launch = () => {
    const game = createGame(players.map((player: any) => player.id))
    startMatch(game)
    navigate('/uno/game')
  }

  return (
    <div className="min-h-screen bg-bg">
      <Topbar title="Salon UNO" subtitle="Matchmaking privé" back />
      <div className="mx-auto flex w-full max-w-xl flex-col gap-6 px-4 pb-32 pt-4">
        <Card className="flex items-center justify-between">
          <div>
            <p className="text-sm font-semibold text-txt">Code du salon</p>
            <p className="text-xs text-muted">Partagez-le pour inviter vos amis</p>
          </div>
          <button
            onClick={() => navigator.clipboard?.writeText('UNO-4587')}
            className="rounded-2xl border border-border/60 px-4 py-2 text-xs font-semibold text-primary transition hover:border-primary/60 hover:bg-primary/10 focus-ring"
          >
            Copier UNO-4587
          </button>
        </Card>

        <section className="space-y-3">
          <div className="flex items-center justify-between">
            <h2 className="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Joueurs</h2>
            <span className="text-xs text-muted">{players.length}/6</span>
          </div>
          <Card className="space-y-3">
            {players.map((player: any) => (
              <div key={player.id} className="flex items-center justify-between rounded-2xl bg-bg px-4 py-3">
                <div className="flex items-center gap-3">
                  <span className="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
                    {player.id.slice(0, 2).toUpperCase()}
                  </span>
                  <div>
                    <p className="text-sm font-semibold text-txt">{player.id}</p>
                    <p className="text-xs text-muted">Équipe A</p>
                  </div>
                </div>
                <span className="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">Prêt</span>
              </div>
            ))}
            <button
              onClick={() => addBot()}
              className="flex w-full items-center justify-center gap-2 rounded-2xl border border-dashed border-border/70 px-4 py-3 text-sm font-semibold text-muted transition hover:border-primary/60 hover:text-primary focus-ring"
            >
              <Plus className="h-4 w-4" />
              Ajouter un bot
            </button>
            <button
              onClick={() => alert('Lien partagé')}
              className="flex w-full items-center justify-center gap-2 rounded-2xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary transition hover:bg-primary/20 focus-ring"
            >
              <Share2 className="h-4 w-4" />
              Inviter un ami
            </button>
          </Card>
        </section>

        <section className="space-y-3">
          <h2 className="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Règles du match</h2>
          <Card className="space-y-3">
            <label className="flex items-center justify-between gap-3 text-sm text-txt">
              <span>
                Empilement +2
                <p className="text-xs text-muted">Cumulez les cartes +2 pour des combos explosifs.</p>
              </span>
              <input
                type="checkbox"
                checked={rules.stackD2}
                onChange={(event) => setRules({ stackD2: event.target.checked })}
                className="h-5 w-5 accent-primary"
              />
            </label>
            <label className="flex items-center justify-between gap-3 text-sm text-txt">
              <span>
                Joker +4 contestable
                <p className="text-xs text-muted">Permet de contester un +4 joué abusivement.</p>
              </span>
              <input
                type="checkbox"
                checked={rules.wild4}
                onChange={(event) => setRules({ wild4: event.target.checked })}
                className="h-5 w-5 accent-primary"
              />
            </label>
            <label className="flex items-center justify-between gap-3 text-sm text-txt">
              <span>
                Timer 20 secondes
                <p className="text-xs text-muted">Assure un rythme soutenu pour chaque tour.</p>
              </span>
              <input
                type="checkbox"
                checked={rules.timer > 0}
                onChange={(event) => setRules({ timer: event.target.checked ? 20 : 0 })}
                className="h-5 w-5 accent-primary"
              />
            </label>
          </Card>
        </section>
      </div>

      <div className="fixed bottom-6 left-0 right-0 flex justify-center px-4">
        <button
          onClick={launch}
          className="w-full max-w-xl rounded-3xl bg-primary py-4 text-base font-semibold text-white shadow-card transition hover:bg-primary/90 focus-ring"
        >
          Lancer la partie
        </button>
      </div>
    </div>
  )
}

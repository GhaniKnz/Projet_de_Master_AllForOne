import React from 'react'
import { useNavigate } from 'react-router-dom'
import { Trophy, Medal } from 'lucide-react'
import Card from '../../components/Card'
import Topbar from '../../components/Topbar'
import { useUnoStore } from '../../store/uno'

export default function UnoResults() {
  const navigate = useNavigate()
  const { results, reset } = useUnoStore((state) => ({ results: state.results, reset: state.reset }))

  const handleBackToLobby = () => {
    reset()
    navigate('/channels')
  }

  const handleReplay = () => {
    reset()
    navigate('/uno/lobby')
  }

  return (
    <div className="min-h-screen bg-bg">
      <Topbar title="Résultats" subtitle="Bravo pour la partie !" back />
      <div className="mx-auto flex w-full max-w-xl flex-col gap-6 px-4 pb-24 pt-6">
        <section className="rounded-3xl border border-primary/40 bg-gradient-to-br from-primary/15 via-white to-accent/15 p-6 text-center shadow-card">
          <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary text-white shadow-soft">
            <Trophy className="h-8 w-8" />
          </div>
          <h1 className="mt-4 text-2xl font-semibold text-txt">Partie terminée</h1>
          <p className="mt-2 text-sm text-muted">
            Merci d’avoir joué ! Consultez le classement ci-dessous et enchaînez sur une revanche pour continuer votre progression.
          </p>
        </section>

        <Card>
          <h2 className="text-sm font-semibold uppercase tracking-[0.2em] text-muted">Classement</h2>
          <ol className="mt-4 space-y-3">
            {results.map((player: string, index: number) => (
              <li key={player} className="flex items-center justify-between rounded-2xl bg-bg px-4 py-3">
                <div className="flex items-center gap-3">
                  <span className="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
                    {index + 1}
                  </span>
                  <div>
                    <p className="text-sm font-semibold text-txt">{player}</p>
                    <p className="text-xs text-muted">Score bonus +75 XP</p>
                  </div>
                </div>
                {index === 0 ? (
                  <span className="flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                    <Medal className="h-4 w-4" />
                    Vainqueur
                  </span>
                ) : null}
              </li>
            ))}
          </ol>
        </Card>

        <div className="flex flex-col gap-3 sm:flex-row">
          <button
            onClick={handleBackToLobby}
            className="flex-1 rounded-2xl border border-border/70 bg-surface px-4 py-3 text-sm font-semibold text-muted transition hover:border-primary/60 hover:text-primary focus-ring"
          >
            Retour aux salons
          </button>
          <button
            onClick={handleReplay}
            className="flex-1 rounded-2xl bg-primary px-4 py-3 text-sm font-semibold text-white shadow-card transition hover:bg-primary/90 focus-ring"
          >
            Rejouer
          </button>
        </div>
      </div>
    </div>
  )
}
